{
  "name": "ts-type-cleaner",
  "version": "5.2.0",
  "description": "TypeScript 类型分析工具 - 自动发现未使用类型、重复定义与类型错误（Vue3/React 项目友好）",
  "type": "module",
  "main": "./lib/index.js",
  "bin": {
    "ts-type-cleaner": "./bin/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "lib/",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "analyze": "node bin/cli.js analyze",
    "check": "node bin/cli.js check",
    "summary": "node bin/cli.js summary",
    "test": "node --test test/**/*.test.js",
    "prepublishOnly": "npm run test"
  },
  "keywords": [
    "typescript",
    "type-checker",
    "code-analysis",
    "static-analysis",
    "unused-types",
    "type-cleaner",
    "vue3",
    "react",
    "cli-tool",
    "code-quality"
  ],
  "author": "CHENY <ycyplus@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/ChenyCHENYU/ts-type-cleaner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenyCHENYU/ts-type-cleaner.git"
  },
  "bugs": {
    "url": "https://github.com/ChenyCHENYU/ts-type-cleaner/issues"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "ora": "^7.0.1",
    "ts-unused-exports": "^11.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.8.0"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
